function Hub:exportKeybindLog()
    local logData = {}
    for _, entry in ipairs(self.keybindLog) do
        table.insert(logData, {
            feature = entry.feature,
            state = entry.state,
            timestamp = entry.time,
            tickTime = entry.tickTime
        })
    end
    return logData
end

function Hub:getGameStats()
    local stats = {
        totalGames = 0,
        totalFeatures = 0,
        enabledFeatures = 0,
        totalToggles = #self.keybindLog
    }
    
    for gameName, gameData in pairs(Games) do
        stats.totalGames = stats.totalGames + 1
        stats.totalFeatures = stats.totalFeatures + #gameData.features
        for _, enabled in pairs(gameData.enabled) do
            if enabled then stats.enabledFeatures = stats.enabledFeatures + 1 end
        end
    end
    
    return stats
end

