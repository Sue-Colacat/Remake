-- ============================================
-- KEY GENERATION & VALIDATION
-- ============================================

local function generateRealisticKeys(tier, count)
    local keys = {}
    local prefixes = {"COLA", "SHADOW", "NEXUS", "PRIME", "ELITE"}
    local suffixes = {"XK", "LK", "PRO", "MAX", "ULTRA"}
    
    for i = 1, count do
        local prefix = prefixes[((i - 1) % #prefixes) + 1]
        local random1 = string.format("%04X", math.random(0, 65535))
        local random2 = string.format("%04X", math.random(0, 65535))
        local checksum = string.format("%02X", (i * 7 + (i % 11)) % 256)
        
        local key = string.format("%s-%s-%s-%s-%s", prefix, tier, random1, random2, checksum)
        table.insert(keys, key)
    end
    return keys
end

local PremiumKeyTiers = {
    ["1DAY"] = {duration = 86400, price = 2.50, keys = generateRealisticKeys("1D", 100)},
    ["2DAY"] = {duration = 172800, price = 3.00, keys = generateRealisticKeys("2D", 100)},
    ["1WEEK"] = {duration = 604800, price = 6.00, keys = generateRealisticKeys("1W", 100)},
    ["1MONTH"] = {duration = 2592000, price = 15.00, keys = generateRealisticKeys("1M", 100)},
    ["LIFETIME"] = {duration = 0, price = 23.00, keys = generateRealisticKeys("LT", 100)}
}

local function validateKey(key)
    for tierName, tierData in pairs(PremiumKeyTiers) do
        for _, validKey in ipairs(tierData.keys) do
            if validKey == key then
                return true, tierData
            end
        end
    end
    return false, nil
end

-- ============================================
-- KEYBIND SYSTEM
-- ============================================

local KeybindManager = {}
KeybindManager.binds = {}
KeybindManager.toggleStates = {}

function KeybindManager:registerBind(featureName, keyCode)
    self.binds[featureName] = {key = keyCode, enabled = false}
    self.toggleStates[featureName] = false
end

function KeybindManager:logToggle(featureName, newState)
    local timestamp = os.date("%Y-%m-%d %H:%M:%S")
    local logEntry = {
        feature = featureName,
        state = newState and "ON" or "OFF",
        time = timestamp,
        tickTime = tick()
    }
    table.insert(Hub.keybindLog, logEntry)
    return logEntry
end

function KeybindManager:executeToggle(featureName)
    local currentState = self.toggleStates[featureName] or false
    local newState = not currentState
    self.toggleStates[featureName] = newState
    self:logToggle(featureName, newState)
    return newState
end

function KeybindManager:remapKey(featureName, newKeyCode)
    if self.binds[featureName] then
        self.binds[featureName].key = newKeyCode
        self:logToggle("KeyRemapped_"..featureName, true)
        return true
    end
    return false
end

